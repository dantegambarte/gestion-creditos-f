{
  "name": "gestion-creditos-f",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:gestion-creditos-f": "node dist/gestion-creditos-f/server/server.mjs",
    "e2e": "cypress open",
    "e2e:run": "node ./cypress/scripts/e2e-run-safe.js",
    "e2e:run:all": "cypress run",
    "e2e:smoke:real": "cypress run --spec \"cypress/e2e/01-auth.cy.ts,cypress/e2e/03-nueva-operacion-real.cy.ts,cypress/e2e/04-clientes-real.cy.ts,cypress/e2e/05-negative-auth.cy.ts,cypress/e2e/09b-cobranzas-collector.cy.ts,cypress/e2e/12-portal-clientes.cy.ts,cypress/e2e/22-admin-generar-planilla-real.cy.ts,cypress/e2e/23-credit-detail.cy.ts,cypress/e2e/37-portal-auth-use-cases.cy.ts,cypress/e2e/50-admin-collections-hardening-real.cy.ts\"",
    "e2e:smoke:real:stable": "start-server-and-test \"npm run start:e2e\" http-get://localhost:4200 \"npm run e2e:smoke:real\"",
    "e2e:report:txt": "cypress run 2>&1 | tee cypress-report.txt",
    "e2e:report": "mochawesome-merge cypress/reports/mocha/*.json -o cypress/reports/report.json && marge cypress/reports/report.json --reportDir cypress/reports --inline",
    "e2e:clean": "node -e \"const fs=require('fs');const d='cypress/reports/mocha';if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>fs.unlinkSync(d+'/'+f));\"",
    "e2e:all": "npm run e2e:clean && npm run e2e:run:all && npm run e2e:report",
    "lint": "eslint --max-warnings 0",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:scope": "node --test scripts/ci-scope.test.mjs",
    "prepare": "husky",
    "format": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/platform-server": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/service-worker": "^20.3.35",
    "@angular/ssr": "^20.3.43",
    "chart.js": "^4.5.1",
    "date-fns": "^3.6.0",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "jasmine": "^6.2.0",
    "jspdf": "^4.2.1",
    "primeicons": "^6.0.1",
    "primeng": "^17.18.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-eslint": "^18.4.3",
    "autoprefixer": "^10.5.0",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.5.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "postcss": "^8.5.10",
    "prettier": "^3.10.1",
    "sharp": "^0.35.3",
    "start-server-and-test": "^2.0.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --max-warnings 0"
    ],
    "src/**/*.{ts,html,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "primeng": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/forms": "$@angular/forms",
      "zone.js": "$zone.js"
    }
  }
}
